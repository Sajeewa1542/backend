{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests,test_data,uploaded_files,__pycache__}/**"
    }
  },
  "installCommand": "pip install -r backend/requirements.txt",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
